# Copy this file to ".env" and replace every REPLACE_ME.
# Get each URL from AiMicromind: open the chatflow -> API button -> copy the API_URL value.

PORT=3000

# Optional: only needed if you set the chatflow's Authorization to "API Key" instead of "No Authorization"
AIMICROMIND_API_KEY=

# CV Analyzer
CV_ANALYZER_URL=https://core.aimicromind.com/api/v1/prediction/REPLACE_ME

# Job Analyzer - replace REPLACE_ME with the real flow id
JOB_ANALYZER_URL=https://core.aimicromind.com/api/v1/prediction/REPLACE_ME

# Matching Agent
MATCHING_URL=https://core.aimicromind.com/api/v1/prediction/REPLACE_ME

# Skill Gap Agent
SKILLGAP_URL=https://core.aimicromind.com/api/v1/prediction/REPLACE_ME

# Roadmap Agent
ROADMAP_URL=https://core.aimicromind.com/api/v1/prediction/REPLACE_ME

# Interview Agent
INTERVIEW_URL=https://core.aimicromind.com/api/v1/prediction/REPLACE_ME

# --- Job Search (Adzuna, free tier) ---
# Sign up free at https://developer.adzuna.com/ to get these two values.
# LinkedIn has no public API for "jobs available to a specific profile" —
# Adzuna is a legitimate free alternative that aggregates listings from many
# sources, including some originally posted on LinkedIn.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code for the job market to search (e.g. gb, us, in, de, fr, ca).
# Egypt (eg) is not supported by Adzuna — check developer.adzuna.com/docs for
# the full list and pick the closest market.
ADZUNA_COUNTRY=gb
