# Copy this file to ".env" and fill in the values.
# On Vercel / Render, set the same variables in the project's Environment settings.

PORT=3000

# --- AI (required) ---
# The 6 agents run on OpenRouter. Create a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: any model id from https://openrouter.ai/models
# Default "openrouter/free" picks a free model automatically (rate limited).
OPENROUTER_MODEL=openrouter/free

# Optional: max time (ms) to wait for each agent reply. Default 90000.
FLOW_TIMEOUT_MS=90000

# --- AiMicromind / Flowise (optional) ---
# Set an agent's URL only if you want that agent to run on your own chatflow
# instead of the built-in prompt. Get it from: chatflow -> API button -> API_URL.
# Leave empty to use the built-in agent.
CV_ANALYZER_URL=
JOB_ANALYZER_URL=
MATCHING_URL=
SKILLGAP_URL=
ROADMAP_URL=
INTERVIEW_URL=
# Only needed if your chatflows use "API Key" authorization
AIMICROMIND_API_KEY=

# --- Job Search (Adzuna, free tier, optional) ---
# Sign up free at https://developer.adzuna.com/ to get these two values.
# LinkedIn has no public API for "jobs available to a specific profile" —
# Adzuna is a legitimate free alternative that aggregates listings from many
# sources, including some originally posted on LinkedIn.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter job market code: gb, us, in, de, fr, ca... Egypt is not
# currently supported by Adzuna — pick the closest market.
ADZUNA_COUNTRY=gb
