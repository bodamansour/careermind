    {
      "parameters": {
        "method": "POST",
        "url": "={{ String($('Config').first().json.careermind_url).replace(/\\/+$/, '') }}/api/match",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ cvText: $json.cv_text, jdText: $json.job_description }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "15e6c97b-1b6f-4c25-a7b5-bb6b8f56c7ca",
      "name": "CareerMind Match",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        380
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "CareerMind API Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Reads the CareerMind reply. If the call failed or the reply has no numeric\n// score, the applicant is saved as REVIEW so a person reads the CV instead of\n// the workflow guessing a score.\nconst app = $('Generate Applicant ID').first().json;\nconst cfg = $('Config').first().json;\nconst r = $input.item.json || {};\nconst ok = typeof r.job_match_score === 'number' && Number.isFinite(r.job_match_score);\nconst score = ok ? Math.max(0, Math.min(100, Math.round(r.job_match_score))) : null;\nconst list = v => (Array.isArray(v) ? v.map(String).filter(Boolean).join(', ') : '');\nlet category = 'REVIEW';\nif (ok) category = score >= cfg.strong_threshold ? 'STRONG' : score >= cfg.possible_threshold ? 'POSSIBLE' : 'WEAK';\nreturn {\n  json: {\n    applicant_id: app.applicant_id,\n    created_at: $now.toISO(),\n    name: app.name,\n    email: app.email,\n    phone: app.phone,\n    job_id: app.job_id,\n    job_title: app.job_title || r.job_title || '',\n    source: app.source,\n    match_score: score,\n    category,\n    matching_skills: ok ? list(r.matching_skills) : '',\n    missing_skills: ok ? list([].concat(r.missing_skills || [], r.partial_match_skills || [])) : '',\n    scoring_mode: ok ? 'CareerMind' : 'Not scored (CareerMind unavailable)',\n    status: 'new',\n  },\n};\n"
      },
      "id": "d7e9e918-bb35-428e-9795-4719989309f6",
      "name": "Final Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        380
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "d7286d3a-cac7-4054-bc7d-910f6c3306d4",
                    "leftValue": "={{ $json.category }}",
                    "rightValue": "STRONG",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "STRONG"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "OTHER"
        }
      },
